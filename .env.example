# Copy to .env and edit.

# api.weather.gov asks clients to identify themselves with a contact address.
CONTACT_EMAIL=you@example.com

# 1 = use built-in recorded/synthetic data (no internet needed). 0 = live APIs.
DEMO_MODE=0

# Optional: AI-written briefing. Leave blank to use the rule-based summary.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

HTTP_TIMEOUT=10
